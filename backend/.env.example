# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration (Optional — app works without it in Demo Mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# WhatsApp Configuration
# NO API KEYS NEEDED! The app uses whatsapp-web.js to connect your personal WhatsApp.
# On first startup, a QR code will appear in the terminal — scan it once with your phone.
# (WhatsApp → Settings → Linked Devices → Link a Device)
# Your session is saved locally in .wwebjs_auth/ so you only need to scan once.
